# Copy to .env (already git-ignored) and fill in real values. Loaded by
# project/settings.py via django-environ at process start; backend/utils.py
# reads the cluster values back out of os.environ the same way.

# Django's SECRET_KEY -- any long random string for local/dev use.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# SSH credentials for the PUC compute cluster (used by backend/utils.py's
# upload_parms() to submit large runs as Slurm jobs).
MATE_CLUSTER_HOST=cluster.ing.uc.cl
MATE_CLUSTER_USER=your-cluster-username
MATE_CLUSTER_PASSWORD=your-cluster-password
MATE_CLUSTER_PARAMS_PATH=/home/your-cluster-username/groups/params
