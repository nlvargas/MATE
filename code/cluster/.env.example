# Copy to .env (already git-ignored) and fill in real values. Loaded by
# utils.py's _load_env_file() the first time a send_* mail helper runs --
# this script runs standalone on the PUC cluster, not inside Django, so it
# can't rely on django-environ / the client app's .env.

# Gmail account MATE sends results from (an app password, not the account
# login password -- see https://support.google.com/accounts/answer/185833).
MATE_GMAIL_ADDRESS=your-sender@gmail.com
MATE_GMAIL_PASSWORD=your-gmail-app-password
