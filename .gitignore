# groups_tests/ -- removed from ignore: tests should be tracked, not silently dropped.

# Runtime scratch from actual solver runs -- real job params/results,
# never portfolio content. Regenerated at runtime; keep the dirs via .gitkeep.
code/server/outputs/*
code/server/params/*
!code/server/outputs/.gitkeep
!code/server/params/.gitkeep

# Generated at deploy time by code/client/deploy_hooks.py (zappa's "zip"
# callback) -- a copy of code/server/model_common.py so it ships inside the
# Lambda package. code/server/model_common.py is the real source; this copy
# is never hand-edited and shouldn't be committed.
code/client/model_common.py
